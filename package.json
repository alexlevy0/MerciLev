{
  "name": "french-corrector-extension",
  "version": "1.0.0",
  "description": "Extension Chrome pour la correction orthographique et grammaticale en français",
  "scripts": {
    "check": "node --experimental-strip-types --no-warnings check-env.ts",
    "build": "node --experimental-strip-types --no-warnings build.ts",
    "test": "node --experimental-strip-types --no-warnings test-all.ts",
    "test:compare": "node --experimental-strip-types --no-warnings test-all.ts --compare",
    "test:e4b": "node --experimental-strip-types --no-warnings test-all.ts --model=gemma3n:e4b",
    "test:e2b": "node --experimental-strip-types --no-warnings test-all.ts --model=gemma3n:e2b",
    "test:granite": "node --experimental-strip-types --no-warnings test-all.ts --model=granite-embedding:278m",
    "test:qwen3b": "node --experimental-strip-types --no-warnings test-all.ts --model=qwen2.5:3b",
    "test:qwen7b": "node --experimental-strip-types --no-warnings test-all.ts --model=qwen2.5:7b",
    "test:qwen32b": "node --experimental-strip-types --no-warnings test-all.ts --model=qwen2.5:32b",
    "dev": "npm run build && npm test",
    "postinstall": "npm run check"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.286",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
