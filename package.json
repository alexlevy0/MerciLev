{
  "name": "french-corrector-extension",
  "version": "1.0.0",
  "description": "Extension Chrome pour la correction orthographique et grammaticale en français",
  "scripts": {
    "check": "node --experimental-strip-types --no-warnings check-env.ts",
    "build": "node --experimental-strip-types --no-warnings build.ts",
    "test": "node --experimental-strip-types --no-warnings run-tests.ts",
    "test:problematic": "node --experimental-strip-types --no-warnings test-problematic-runner.ts",
    "test:e4b": "node --experimental-strip-types --no-warnings test-with-model.ts gemma3n:e4b",
    "test:e2b": "node --experimental-strip-types --no-warnings test-with-model.ts gemma3n:e2b",
    "test:compare": "node --experimental-strip-types --no-warnings compare-models.ts",
    "dev": "npm run build && npm test",
    "postinstall": "npm run check"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.286",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
